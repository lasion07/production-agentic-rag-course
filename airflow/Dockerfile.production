FROM python:3.12-slim

ARG AIRFLOW_VERSION=2.10.3
ARG PYTHON_VERSION=3.12
ENV AIRFLOW_HOME=/opt/airflow \
    PYTHONPATH=/opt/airflow/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential curl libpq-dev poppler-utils tesseract-ocr && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 50000 airflow && \
    useradd --uid 50000 --gid 50000 --create-home --home-dir /opt/airflow --shell /usr/sbin/nologin --no-log-init airflow

RUN pip install --no-cache-dir \
    "apache-airflow[postgres]==${AIRFLOW_VERSION}" \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${PYTHON_VERSION}.txt" \
    psycopg2-binary

COPY airflow/requirements-airflow.txt /tmp/requirements-airflow.txt
RUN pip install --no-cache-dir -r /tmp/requirements-airflow.txt

COPY --chown=50000:50000 src /opt/airflow/src
COPY --chown=50000:50000 airflow/dags /opt/airflow/dags
COPY --chmod=0555 airflow/production-entrypoint.sh /usr/local/bin/airflow-production-entrypoint

RUN mkdir -p /opt/airflow/logs /opt/airflow/data && chown -R 50000:50000 /opt/airflow

USER 50000:50000
WORKDIR /opt/airflow
ENTRYPOINT ["/usr/local/bin/airflow-production-entrypoint"]
CMD ["airflow", "scheduler"]
