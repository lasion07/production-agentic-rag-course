{
    email {$ACME_EMAIL}
    admin off
}

{$RAG_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    reverse_proxy api:8000 {
        health_uri /api/v1/live
        health_interval 30s
        health_timeout 2s
    }
}
