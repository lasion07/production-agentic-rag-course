# Non-secret production deployment values. Copy outside source control, replace
# every example value, then pass it with `docker compose --env-file`.
RAG_API_IMAGE=registry.example.com/agentic-rag/api:0.1.0
RAG_AIRFLOW_IMAGE=registry.example.com/agentic-rag/airflow:0.1.0
RAG_DOMAIN=rag.example.com
ACME_EMAIL=ops@example.com
PRODUCTION_SECRETS_DIR=./deploy/secrets

OPENSEARCH_HOST=https://search.internal.example.com:9200
OPENSEARCH_USERNAME=rag_service
OPENSEARCH__INDEX_GENERATION=v1
OPENSEARCH__READ_ALIAS_SUFFIX=read
OPENSEARCH__WRITE_ALIAS_SUFFIX=write
REDIS_HOST=redis.internal.example.com
REDIS_PORT=6379
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

LLM_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_ALLOWED_MODELS=["gpt-5.4-mini-2026-03-17"]
LANGFUSE_CAPTURE_CONTENT=true
ALLOW_PRODUCTION_CONTENT_CAPTURE=true
